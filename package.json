{
  "name": "zeyhermutteros",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "node scripts/with-cloudflare-env.mjs beta react-router dev",
    "build": "pnpm run build:beta",
    "build:beta": "node scripts/with-cloudflare-env.mjs beta react-router build",
    "build:production": "node scripts/with-cloudflare-env.mjs production react-router build",
    "deploy": "node scripts/require-explicit-deploy-target.mjs",
    "deploy:zugaenge:beta": "node scripts/pruefe-deploy-zugaenge.mjs beta",
    "deploy:zugaenge:production": "node scripts/pruefe-deploy-zugaenge.mjs production",
    "deploy:funktionen:beta": "node scripts/deploy-edge-funktionen.mjs beta",
    "deploy:funktionen:production": "node scripts/deploy-edge-funktionen.mjs production",
    "deploy:beta": "pnpm run deploy:zugaenge:beta && pnpm run check:beta && pnpm run deploy:funktionen:beta && wrangler deploy",
    "deploy:production": "pnpm run deploy:zugaenge:production && node scripts/guard-production-deploy.mjs && pnpm run check:production && pnpm run deploy:funktionen:production && wrangler deploy",
    "typegen": "react-router typegen",
    "cf-typegen": "wrangler types --include-runtime=false",
    "typecheck": "react-router typegen && tsc -b",
    "check": "pnpm run check:beta",
    "check:brand-logo": "node scripts/check-brand-logo.mjs",
    "check:anzeigeformate": "node scripts/check-anzeigeformate.mjs",
    "check:rohe-enums": "node scripts/check-rohe-enums.mjs",
    "check:leerbehauptung": "node scripts/check-leerbehauptung.mjs",
    "check:tote-beschriftungen": "node scripts/check-tote-beschriftungen.mjs",
    "check:beta": "pnpm run check:quellen && pnpm run typecheck && pnpm run build:beta && wrangler deploy --dry-run",
    "check:production": "pnpm run check:quellen && pnpm run typecheck && pnpm run build:production && wrangler deploy --dry-run",
    "anleitung:docx": "node --experimental-strip-types scripts/build-anleitung-docx.mjs",
    "check:goldschrift": "node scripts/check-goldschrift.mjs",
    "check:honigtopf": "node scripts/check-honigtopf.mjs",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "check:seitenkopf": "node scripts/check-seitenkopf.mjs",
    "check:hero-bild": "node scripts/check-hero-bild.mjs",
    "check:quellen": "pnpm run check:brand-logo && pnpm run check:goldschrift && pnpm run check:hero-bild && pnpm run check:anzeigeformate && pnpm run check:rohe-enums && pnpm run check:leerbehauptung && pnpm run check:tote-beschriftungen && pnpm run check:honigtopf && pnpm run check:sitemap && pnpm run check:seitenkopf && pnpm run check:pruefketten && pnpm run check:edge-funktionen && pnpm run check:wrangler-konfig && pnpm run check:inhaltsbreite && pnpm run check:workflows && pnpm run check:formular-geschlossen && pnpm run check:objektakte-navigation && pnpm run check:abstaende && pnpm run check:terminfarben",
    "check:pruefketten": "node scripts/check-pruefketten.mjs",
    "check:edge-funktionen": "node scripts/check-edge-funktionen.mjs",
    "check:wrangler-konfig": "node scripts/check-wrangler-konfig.mjs",
    "check:inhaltsbreite": "node scripts/check-inhaltsbreite.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:formular-geschlossen": "node scripts/check-formular-geschlossen.mjs",
    "check:objektakte-navigation": "node scripts/check-objektakte-navigation.mjs",
    "check:abstaende": "node scripts/check-abstaende.mjs",
    "check:terminfarben": "node scripts/check-terminfarben.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "isbot": "5.1.32",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-router": "7.9.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@cloudflare/workers-types": "5.20260829.1",
    "@react-router/dev": "7.9.6",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "7.1.7",
    "wrangler": "4.123.0"
  },
  "engines": {
    "node": ">=22"
  }
}
