{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zeyhermutter",
  // Das Cloudflare-Konto ist festgeschrieben, damit ein Deploy mit der falschen
  // Anmeldung abbricht statt still einen neuen Worker im fremden Konto anzulegen.
  // Das ist real moeglich: auf demselben Rechner laeuft ein zweites Projekt in
  // einem anderen Cloudflare-Konto, und "wrangler login" gilt fuer den ganzen
  // Windows-Benutzer. Eine Konto-ID ist kein Geheimnis.
  "account_id": "4196e568b62dcabd2125646072b6c4aa",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "vars": {
    "APP_ENV": "beta",
    "APP_BASE_URL": "https://zeyhermutter.playsony.workers.dev",
    "SUPABASE_URL": "https://zqhcxudpfwsfuokencvy.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_9KqTRvRzAYxDAPWAzMDRTA_9QhasRgx",
    "SALES_READINESS_BACKEND_ENABLED": "true",
    "SELLER_CHECK_PUBLIC_ENABLED": "true",
    "SALES_READINESS_AI_ENABLED": "true",
    "SALES_READINESS_AI_MODEL": "gpt-5.6-terra"
  },
  "env": {
    "beta": {
      "name": "zeyhermutter",
      "vars": {
        "APP_ENV": "beta",
        "APP_BASE_URL": "https://zeyhermutter.playsony.workers.dev",
        "SUPABASE_URL": "https://zqhcxudpfwsfuokencvy.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_9KqTRvRzAYxDAPWAzMDRTA_9QhasRgx",
        "SALES_READINESS_BACKEND_ENABLED": "true",
        "SELLER_CHECK_PUBLIC_ENABLED": "true",
        "SALES_READINESS_AI_ENABLED": "true",
        "SALES_READINESS_AI_MODEL": "gpt-5.6-terra"
      }
    },
    "production": {
      "name": "zeyhermutter-production",
      "vars": {
        "APP_ENV": "production",
        "APP_BASE_URL": "https://zeyhermutter-production.playsony.workers.dev",
        "SUPABASE_URL": "https://vtmtxaaojbqqzwxkodye.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_aKJnsv7nAwRSPerPU11vkg_ZsQOCjAl",
        "SALES_READINESS_BACKEND_ENABLED": "false",
        "SELLER_CHECK_PUBLIC_ENABLED": "false",
        "SALES_READINESS_AI_ENABLED": "false",
        "SALES_READINESS_AI_MODEL": "gpt-5.6-terra"
      }
    }
  }
