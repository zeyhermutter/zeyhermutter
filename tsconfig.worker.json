{
  "extends": "./tsconfig.json",
  "include": [
    "workers/**/*",
    "app/cloudflare-context.d.ts",
    ".react-router/types/+server-build.d.ts",
    "worker-configuration.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"]
    }
  }
}
